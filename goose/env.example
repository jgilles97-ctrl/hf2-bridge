# Copy this file to ~/.config/hf2-bridge/env and chmod 600 the copy.
# Do not commit the copy or paste the key into GitHub.
GOOSE_PROVIDER=openai
GOOSE_MODEL=CHOOSE_A_TOOL_CALLING_VENICE_MODEL
OPENAI_HOST=https://api.venice.ai
OPENAI_BASE_PATH=/api/v1
VENICE_API_KEY=PASTE_KEY_LOCALLY_ONLY
OPENAI_API_KEY=${VENICE_API_KEY}

