# Copy this file to ~/.config/hf2-bridge/env and chmod 600 the copy.
# Do not commit the copy or paste the key into GitHub.
GOOSE_PROVIDER=venice
GOOSE_MODEL=z-ai-glm-5-3-flash
VENICE_API_KEY=PASTE_KEY_LOCALLY_ONLY
# Optional overrides supported by current Goose documentation:
# VENICE_HOST=https://api.venice.ai
# VENICE_BASE_PATH=/api/v1

